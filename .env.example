# Copy this file to .env and fill in your values.

# --- Vector store (required) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=documind
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Answer generation: any OpenAI-compatible endpoint (defaults to local Ollama) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2

# --- Background ingestion + semantic cache (optional; leave blank to ingest inline) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Guardrails and cache tuning (optional) ---
OFFTOPIC_SCORE_THRESHOLD=0.35
CACHE_SIMILARITY_THRESHOLD=0.92

# --- RAGAS evaluation only (optional) ---
OPENAI_API_KEY=your-openai-api-key
